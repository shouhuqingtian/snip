<Window x:Class="Snip.App.Views.TextDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="编辑文字" Width="520" Height="430" MinWidth="450" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="文字标注" Style="{StaticResource PageTitle}"/><TextBlock Text="输入想表达的内容，支持多行。" Style="{StaticResource Subtitle}" Margin="0,6,0,0"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <WrapPanel><TextBlock Text="颜色" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="ColorBox" Width="120" Margin="10,0,20,0" ToolTip="十六进制颜色，例如 #FF3B30"/><TextBlock Text="字号" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="SizeBox" Width="85" Margin="10,0,0,0"/></WrapPanel>
   <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="取消" IsCancel="True" MinWidth="84"/><Button Content="确定" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="ConfirmClick" MinWidth="84"/></StackPanel>
  </StackPanel>
  <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="14" FontSize="15"/>
 </DockPanel>
</Window>
