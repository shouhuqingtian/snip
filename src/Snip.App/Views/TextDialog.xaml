<Window x:Class="Snip.App.Views.TextDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="编辑文字" Width="470" Height="350" MinWidth="400" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom">
      <WrapPanel Margin="0,10,0,0">
        <TextBlock Text="颜色 #RRGGBB" VerticalAlignment="Center"/>
        <TextBox x:Name="ColorBox" Width="100" Margin="8,0" Padding="5"/>
        <TextBlock Text="字号" VerticalAlignment="Center"/>
        <ComboBox x:Name="SizeBox" Width="75"/>
      </WrapPanel>
      <TextBlock x:Name="ErrorText" Foreground="#CC3030" TextWrapping="Wrap" Margin="0,5"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True"/><Button Content="确定" IsDefault="True" Click="ConfirmClick"/>
      </StackPanel>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="输入标注文字（支持多行）" Margin="0,0,0,10"/>
    <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/>
  </DockPanel>
</Window>
