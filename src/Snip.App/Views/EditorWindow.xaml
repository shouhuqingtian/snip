<Window x:Class="Snip.App.Views.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Snip.App.Views"
        Title="自用截图 · 编辑" Width="1100" Height="760" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterScreen">
  <Window.Resources><local:ToolConverter x:Key="ToolConverter"/></Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}"/>
    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
  </Window.InputBindings>
  <DockPanel>
    <local:EditorToolbar x:Name="ToolbarControl" DockPanel.Dock="Top" Margin="16,12,16,12"/>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="−" Command="{Binding ZoomOutCommand}" Padding="10,3"/>
          <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Margin="8,0"/>
          <Button Content="+" Command="{Binding ZoomInCommand}" Padding="10,3"/>
          <Button x:Name="FitWindowButton" Content="适应窗口" Command="{Binding FitWindowCommand}" Padding="10,3" ToolTip="显示整张图片；窗口大小变化时自动调整">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsFitWindow}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
          <Button x:Name="FitWidthButton" Content="适应宽度" Command="{Binding FitWidthCommand}" Padding="10,3" ToolTip="按编辑区宽度铺开图片，长图上下滚动查看；窗口大小变化时自动调整">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsFitWidth}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" Background="{StaticResource CanvasBrush}" Padding="24">
      <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Style.Triggers><DataTrigger Binding="{Binding IsFitWidth}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
      <local:EditorCanvas HorizontalAlignment="Left" VerticalAlignment="Top">
        <local:EditorCanvas.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></local:EditorCanvas.LayoutTransform>
      </local:EditorCanvas>
    </ScrollViewer>
  </DockPanel>
</Window>
