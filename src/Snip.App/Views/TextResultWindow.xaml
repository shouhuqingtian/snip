<Window x:Class="Snip.App.Views.TextResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding WindowTitle}" Width="1040" Height="660" MinWidth="820" MinHeight="480" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel>
    <TextBlock Text="识别语言" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="110"/>
    <Button Content="重新识别" Command="{Binding OcrCommand}"/>
    <ComboBox SelectedValue="{Binding Direction, Mode=TwoWay}" SelectedValuePath="Tag" Width="130"><ComboBoxItem Content="英文 → 中文" Tag="en-zh"/><ComboBoxItem Content="中文 → 英文" Tag="zh-en"/></ComboBox>
    <Button Content="离线翻译" Command="{Binding TranslateCommand}"/>
    <Button Content="下载 / 修复模型" Command="{Binding DownloadCommand}"/>
    <Button Content="取消操作" Command="{Binding CancelCommand}"/>
   </WrapPanel>
   <TextBlock Text="先识别截图文字；可修正原文后复制或翻译。翻译模型约 221 MB，下载并校验后可断网使用。" TextWrapping="Wrap" Foreground="#61758B" Margin="0,6,0,12"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Maximum="100" Height="6"/>
   <TextBlock Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <TextBlock x:Name="ClipboardStatus" Text="{Binding CopyStatus, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="截图预览" FontWeight="Bold" Margin="0,0,0,10"/>
    <Border Background="#E8EDF2" BorderBrush="#D9E1EA" BorderThickness="1" Padding="8">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Image x:Name="ScreenshotPreview" Source="{Binding PreviewImage, Mode=OneWay}" Stretch="Uniform" VerticalAlignment="Top"/>
     </ScrollViewer>
    </Border>
   </DockPanel>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="*"/>
     <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding ShowTranslation}" Value="True"><Setter Property="Height" Value="*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
    </Grid.RowDefinitions>
    <DockPanel>
     <DockPanel DockPanel.Dock="Top"><Button x:Name="CopySourceButton" Content="复制文字" Command="{Binding CopySourceCommand}" DockPanel.Dock="Right"/><TextBlock Text="识别文字（可修改）" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
     <TextBox x:Name="RecognizedText" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding ShowTranslation, Converter={StaticResource BoolVisibility}}">
     <DockPanel DockPanel.Dock="Top"><Button x:Name="CopyTranslationButton" Content="复制译文" Command="{Binding CopyTranslationCommand}" DockPanel.Dock="Right"/><TextBlock Text="翻译结果" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
     <TextBox x:Name="TranslatedText" Text="{Binding Translated, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
