<Window x:Class="Snip.App.Views.TextResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Snip.App.Views" xmlns:translation="clr-namespace:Snip.Translation;assembly=Snip.Translation" xmlns:core="clr-namespace:Snip.Core;assembly=Snip.Core"
 Title="{Binding WindowTitle}" Width="1200" Height="860" MinWidth="860" MinHeight="640" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="移回当前屏幕" Click="RecoverClick" Style="{StaticResource QuietButton}"/><Button x:Name="CloseResultButton" Content="关闭 Esc" Click="CloseClick"/></StackPanel>
   <StackPanel><TextBlock Text="文字工作台" Style="{StaticResource PageTitle}"/><TextBlock Text="提取、修正与翻译，清楚地看完整句话。" Style="{StaticResource Subtitle}" FontSize="12"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,14"><StackPanel>
   <WrapPanel Visibility="{Binding SupportsOcrModes,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
    <TextBlock Text="文字识别" VerticalAlignment="Center" Margin="4,0,8,0"/>
    <ComboBox x:Name="OcrModeBox" SelectedValue="{Binding RecognitionMode,Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding CanChangeOcrMode}" Width="210"><ComboBoxItem Content="系统识别（免下载）" Tag="{x:Static core:OcrMode.System}"/><ComboBoxItem Content="增强离线识别" Tag="{x:Static core:OcrMode.EnhancedOffline}"/><ComboBoxItem Content="在线视觉识别" Tag="{x:Static core:OcrMode.Online}"/></ComboBox>
    <Button x:Name="SaveOcrSettingsButton" Content="保存识别默认" Command="{Binding SaveOcrSettingsCommand}"/>
   </WrapPanel>
   <TextBlock Text="{Binding OcrModeNotice}" Visibility="{Binding SupportsOcrModes,Converter={StaticResource BoolVisibility}}" Style="{StaticResource Subtitle}" FontSize="11" Margin="4,0,4,6"/>
   <WrapPanel>
   <ComboBox x:Name="TranslationDirectionBox" SelectedValue="{Binding Direction,Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding CanChangeTranslationMode}" Width="156" ToolTip="{Binding DirectionHint}"><ComboBoxItem Content="自动（中英互译）" Tag="auto"/><ComboBoxItem Content="英文 → 中文" Tag="en-zh"/><ComboBoxItem Content="中文 → 英文" Tag="zh-en"/></ComboBox>
   <ComboBox x:Name="TranslationModeBox" SelectedValue="{Binding Mode,Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding CanChangeTranslationMode}" Width="158"><ComboBoxItem Content="在线大模型" Tag="{x:Static core:TranslationMode.Online}"/><ComboBoxItem Content="离线模型" Tag="{x:Static core:TranslationMode.Offline}"/><ComboBoxItem Content="基础词典（离线）" Tag="{x:Static core:TranslationMode.Basic}"/></ComboBox>
   <Button Content="{Binding TranslationActionText}" Style="{StaticResource PrimaryButton}" Command="{Binding TranslateCommand}"/>
   <Button Content="重新识别" Command="{Binding OcrCommand}"/>
   <Button Content="在线设置" Command="{Binding ConfigureOnlineCommand}" Style="{StaticResource QuietButton}"/>
   <Button x:Name="MoreSettingsButton" Content="更多设置" Command="{Binding ToggleOptionsCommand}" Style="{StaticResource QuietButton}"/>
   <Button Content="取消操作" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/>
  </WrapPanel></StackPanel></Border>
  <Popup x:Name="TextOptionsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=MoreSettingsButton}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" IsOpen="{Binding ShowOptions,Mode=TwoWay}" AllowsTransparency="True" StaysOpen="False">
   <Border Style="{StaticResource Card}" Width="650" Padding="18" Margin="4"><StackPanel>
    <TextBlock Text="识别与翻译设置" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
    <StackPanel Visibility="{Binding SupportsSpeechModes,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"><WrapPanel><TextBlock Text="发音方式" VerticalAlignment="Center" Margin="3,0,8,0"/><ComboBox x:Name="VoiceModeBox" SelectedValue="{Binding VoiceMode}" SelectedValuePath="Tag" IsEnabled="{Binding CanChangeVoiceMode}" Width="210"><ComboBoxItem Content="Windows 系统语音" Tag="{x:Static core:SpeechMode.System}"/><ComboBoxItem Content="在线 AI 语音" Tag="{x:Static core:SpeechMode.Online}"/></ComboBox><Button x:Name="ConfigureAiVoiceButton" Content="AI 语音设置 / 试听" Command="{Binding ConfigureSpeechCommand}"/></WrapPanel><TextBlock Text="选择后自动保存。在线发音仅在点击喇叭时发送对应文字，失败可手动切回系统语音。" Style="{StaticResource Subtitle}" TextWrapping="Wrap" FontSize="11" Margin="3,6,0,0"/></StackPanel>
    <TextBlock Text="{Binding ReadingLayoutStatus}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="3,0,0,10"/>
    <WrapPanel><TextBlock Text="识别语言" VerticalAlignment="Center" Margin="3,0,8,0"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" IsEnabled="{Binding CanSelectOcrLanguage}" Width="160"/><Button x:Name="SaveTranslationSettingsButton" Content="保存翻译默认" Command="{Binding SaveTranslationSettingsCommand}"/></WrapPanel>
    <TextBlock Text="{Binding DirectionHint}" Style="{StaticResource Subtitle}" FontSize="12" Margin="3,8,0,10"/>
    <StackPanel Visibility="{Binding SupportsEnhancedOcr,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
     <WrapPanel><CheckBox x:Name="EnhancedOcrBox" Content="增强离线识别（中英自动）" IsChecked="{Binding UseEnhancedOcr}" IsEnabled="{Binding CanSwitchOcr}" VerticalAlignment="Center" Margin="3,0,12,0"><CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SupportsOcrModes}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox><Button x:Name="DownloadOcrButton" Content="下载 / 修复增强 OCR" Command="{Binding DownloadOcrCommand}"/></WrapPanel>
     <TextBlock Text="{Binding OcrModelStatus}" Style="{StaticResource Subtitle}" FontSize="12" Margin="3,6,0,0"/>
     <TextBlock Style="{StaticResource Subtitle}" FontSize="12" Margin="3,6,0,0">运行库缺失时可安装 <Hyperlink NavigateUri="https://aka.ms/vs/17/release/vc_redist.x64.exe" RequestNavigate="RuntimeDownloadNavigate">微软 Visual C++ x64 运行库</Hyperlink>。</TextBlock>
    </StackPanel>
    <StackPanel Visibility="{Binding ShowLocalCompute,Converter={StaticResource BoolVisibility}}">
     <WrapPanel><TextBlock Text="离线计算" VerticalAlignment="Center" Margin="3,0,8,0"/><ComboBox x:Name="ComputeModeBox" SelectedValue="{Binding ComputeMode,Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding CanUseLocalCompute}" Width="210"><ComboBoxItem Content="自动（GPU 可用时优先）" Tag="{x:Static translation:TranslationComputeMode.Auto}"/><ComboBoxItem Content="仅 CPU" Tag="{x:Static translation:TranslationComputeMode.Cpu}"/><ComboBoxItem Content="优先 GPU（可回退 CPU）" Tag="{x:Static translation:TranslationComputeMode.Gpu}"/></ComboBox></WrapPanel>
     <WrapPanel><Button Content="下载 / 修复模型" Command="{Binding DownloadCommand}"/><Button x:Name="DownloadGpuButton" Content="下载 / 修复 GPU 支持" Command="{Binding DownloadGpuCommand}"/></WrapPanel>
     <TextBlock Text="{Binding ComputeStatus}" Style="{StaticResource Subtitle}" FontSize="12" Margin="3,8,0,0"/>
     <TextBlock Visibility="{Binding NeedsWindowsRuntime,Converter={StaticResource BoolVisibility}}" Style="{StaticResource Subtitle}" FontSize="12" Margin="3,8,0,0">离线翻译需要微软 Visual C++ x64 运行库：<Hyperlink NavigateUri="https://aka.ms/vs/17/release/vc_redist.x64.exe" RequestNavigate="RuntimeDownloadNavigate">微软官网下载</Hyperlink>。</TextBlock>
    </StackPanel>
   </StackPanel></Border>
  </Popup>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.6*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="14"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="截图预览" Style="{StaticResource SectionTitle}"/><TextBlock Text="核对原始画面" Style="{StaticResource Subtitle}" FontSize="12"/></StackPanel>
    <Border Background="{StaticResource CanvasBrush}" CornerRadius="10" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Image x:Name="ScreenshotPreview" Source="{Binding PreviewImage,Mode=OneWay}" Stretch="Uniform" VerticalAlignment="Top"/></ScrollViewer></Border>
   </DockPanel></Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="Auto"/><Style.Triggers><DataTrigger Binding="{Binding ShowTranslation}" Value="False"><Setter Property="Height" Value="*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding ShowTranslation}" Value="False"><Setter Property="Height" Value="0"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="12"><DockPanel>
     <WrapPanel DockPanel.Dock="Top">
      <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button x:Name="SpeakSourceButton" Command="{Binding SpeakSourceCommand}" ToolTip="{Binding SourceSpeechActionText}" Visibility="{Binding ShowSourceSpeechButton,Converter={StaticResource BoolVisibility}}" Padding="8,5"><StackPanel Orientation="Horizontal"><local:UiIcon Kind="speaker" Width="18" Height="18"/><TextBlock Text="{Binding SourceSpeechActionText}" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel></Button>
      <Button x:Name="ToggleSourceButton" Content="{Binding SourceToggleText}" ToolTip="{Binding ReadingLayoutStatus}" Command="{Binding ToggleSourceCommand}" Style="{StaticResource QuietButton}" Padding="8,5" Visibility="{Binding ShowTranslation,Converter={StaticResource BoolVisibility}}"/>
      <Button x:Name="OpenSourceReadingButton" Content="放大阅读" Click="OpenSourceReadingClick" Padding="10,5"/>
      <Button x:Name="CopySourceButton" Content="复制文字" Command="{Binding CopySourceCommand}" Padding="10,5"/>
     </WrapPanel>
     <TextBox x:Name="RecognizedText" Text="{Binding Source,UpdateSourceTrigger=PropertyChanged}" MinHeight="70" Visibility="{Binding SourceExpanded,Converter={StaticResource BoolVisibility}}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" Padding="12" Margin="0,8,0,0" Background="#FAFCFB"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><DataTrigger Binding="{Binding ShowTranslation}" Value="True"><Setter Property="MaxHeight" Value="90"/></DataTrigger><DataTrigger Binding="{Binding HasSourceLayout}" Value="True"><Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
    </DockPanel></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0" Visibility="{Binding ShowTranslation,Converter={StaticResource BoolVisibility}}"><DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button x:Name="SpeakTranslationButton" Command="{Binding SpeakTranslationCommand}" ToolTip="{Binding SpeechActionText}" Visibility="{Binding ShowSpeechButton,Converter={StaticResource BoolVisibility}}" Padding="8,6"><StackPanel Orientation="Horizontal"><local:UiIcon Kind="speaker" Width="18" Height="18"/><TextBlock Text="{Binding SpeechActionText}" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel></Button>
       <Button x:Name="OpenReadingButton" IsEnabled="{Binding HasTranslation}" Content="放大阅读" Click="OpenReadingClick" Padding="10,6"/>
       <Button x:Name="CopyTranslationButton" Content="复制译文" Command="{Binding CopyTranslationCommand}" Padding="10,6"/>
      </StackPanel><TextBlock Text="{Binding TranslationResultTitle}" Style="{StaticResource SectionTitle}"/></DockPanel>
      <TextBlock x:Name="ResultDirectionLabel" Text="{Binding ResultDirection}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
      <TextBlock Text="{Binding TranslationNotice}" ToolTip="{Binding TranslationNotice}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <TabControl x:Name="TranslationTabs" SelectedIndex="{Binding ResultTab,Mode=TwoWay}" Style="{StaticResource TranslationTabs}">
      <TabItem x:Name="TranslationBodyTab" Header="完整译文" Style="{StaticResource TranslationTab}"><TextBox x:Name="TranslatedText" MinHeight="70" Text="{Binding Translated,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="15" Padding="12" Background="#FAFCFB"/></TabItem>
      <TabItem x:Name="LanguageNotesTab" Header="读音与词汇" IsEnabled="{Binding HasLanguageNotes}" Style="{StaticResource TranslationTab}"><TextBox x:Name="TranslationLanguageNotes" Text="{Binding LanguageNotes,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" Padding="12" Background="#F0F7F4"/></TabItem>
     </TabControl>
    </DockPanel></Border>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="3" Margin="3,12,3,0">
   <ProgressBar Value="{Binding Progress,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate,Mode=OneWay}" Maximum="100" Height="3" Margin="0,0,0,7" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/>
   <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Style="{StaticResource Subtitle}" FontSize="12" MaxHeight="44"/>
   <TextBlock x:Name="ClipboardStatus" Text="{Binding CopyStatus}" Style="{StaticResource TranslationStatus}"/>
   <TextBlock x:Name="SpeechStatusLabel" Text="{Binding SpeechStatus}" Style="{StaticResource TranslationStatus}"/>
  </StackPanel>
 </Grid>
</Window>
