<Window x:Class="Snip.App.Views.TextResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:translation="clr-namespace:Snip.Translation;assembly=Snip.Translation" Title="{Binding WindowTitle}" Width="1140" Height="860" MinWidth="850" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <DockPanel Margin="16">
  <DockPanel DockPanel.Dock="Top" Margin="8,0,8,8">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="移回当前屏幕" Click="RecoverClick" Style="{StaticResource QuietButton}"/><Button x:Name="CloseResultButton" Content="关闭 Esc" Click="CloseClick"/></StackPanel>
   <TextBlock Text="文字工作台" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
  </DockPanel>
  <ScrollViewer x:Name="WorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
  <Grid MinWidth="786" MinHeight="740" Width="{Binding ElementName=WorkspaceScroll, Path=ViewportWidth, Mode=OneWay}" Height="{Binding ElementName=WorkspaceScroll, Path=ViewportHeight, Mode=OneWay}">
  <DockPanel Margin="8">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="从画面提取文字，修正、复制，或进行离线中英互译。" Style="{StaticResource Subtitle}" Margin="0,6,0,14"/>
   <Border Style="{StaticResource Card}" Padding="12,9"><WrapPanel VerticalAlignment="Center">
    <TextBlock Text="识别语言" Foreground="{StaticResource MutedBrush}" Margin="6,0,6,0" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="142"/>
    <Button Content="重新识别" Command="{Binding OcrCommand}"/>
    <Border Width="1" Height="22" Background="{StaticResource StrokeBrush}" Margin="12,0"/>
    <ComboBox SelectedValue="{Binding Direction, Mode=TwoWay}" SelectedValuePath="Tag" Width="138"><ComboBoxItem Content="英文 → 中文" Tag="en-zh"/><ComboBoxItem Content="中文 → 英文" Tag="zh-en"/></ComboBox>
    <CheckBox Content="在线大模型" IsEnabled="{Binding CanChangeTranslationMode}" IsChecked="{Binding UseOnlineTranslation}" VerticalAlignment="Center" Margin="10,0" ToolTip="选择后将原文发送给配置的服务"/>
    <Button Content="{Binding TranslationActionText}" Style="{StaticResource PrimaryButton}" Command="{Binding TranslateCommand}"/>
    <Button Content="在线设置" Style="{StaticResource QuietButton}" Command="{Binding ConfigureOnlineCommand}"/>
    <Button Content="下载 / 修复模型" Style="{StaticResource QuietButton}" Command="{Binding DownloadCommand}"/>
    <Button Content="取消操作" Style="{StaticResource QuietButton}" Command="{Binding CancelCommand}"/>
   </WrapPanel></Border>
   <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,8,0,0"><WrapPanel>
    <TextBlock Text="离线计算" Foreground="{StaticResource MutedBrush}" Margin="6,0,8,0" VerticalAlignment="Center"/>
    <ComboBox x:Name="ComputeModeBox" SelectedValue="{Binding ComputeMode, Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding CanUseLocalCompute}" Width="198" ToolTip="Vulkan 支持兼容的 NVIDIA、AMD、Intel 显卡；无兼容设备或失败时回退 CPU。">
     <ComboBoxItem Content="自动（GPU 可用时优先）" Tag="{x:Static translation:TranslationComputeMode.Auto}"/>
     <ComboBoxItem Content="仅 CPU" Tag="{x:Static translation:TranslationComputeMode.Cpu}"/>
     <ComboBoxItem Content="优先 GPU（可回退 CPU）" Tag="{x:Static translation:TranslationComputeMode.Gpu}"/>
    </ComboBox>
    <Button x:Name="DownloadGpuButton" Content="下载 / 修复 GPU 支持" Command="{Binding DownloadGpuCommand}" Style="{StaticResource QuietButton}" ToolTip="仅下载约 32 MB Vulkan 运行库，不重新下载翻译模型。"/>
    <TextBlock Text="{Binding ComputeStatus}" Style="{StaticResource Subtitle}" FontSize="12" Margin="10,0,6,0" VerticalAlignment="Center"/>
   </WrapPanel></Border>
   <TextBlock Visibility="{Binding NeedsWindowsRuntime, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Subtitle}" FontSize="12" Margin="6,8,0,0" TextWrapping="Wrap">离线翻译需要微软 Visual C++ x64 运行库：<Hyperlink NavigateUri="https://aka.ms/vs/17/release/vc_redist.x64.exe" RequestNavigate="RuntimeDownloadNavigate">微软官网下载</Hyperlink>，安装后重启软件。</TextBlock>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,12" Margin="0,16,0,0">
   <StackPanel><ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,0,8"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Text="{Binding Status, Mode=OneWay}" Style="{StaticResource Subtitle}" FontSize="12"/><TextBlock x:Name="ClipboardStatus" Text="{Binding CopyStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding CopyStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="截图预览" Style="{StaticResource SectionTitle}"/><TextBlock Text="原始画面，方便核对识别结果" Style="{StaticResource Subtitle}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    <Border Background="{StaticResource CanvasBrush}" CornerRadius="10" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Image x:Name="ScreenshotPreview" Source="{Binding PreviewImage, Mode=OneWay}" Stretch="Uniform" VerticalAlignment="Top"/></ScrollViewer></Border>
   </DockPanel></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding ShowTranslation}" Value="True"><Setter Property="Height" Value="*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="16"><DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button x:Name="CopySourceButton" Content="复制文字" Command="{Binding CopySourceCommand}" DockPanel.Dock="Right" Margin="0"/><StackPanel><TextBlock Text="识别文字" Style="{StaticResource SectionTitle}"/><TextBlock Text="可以直接修改和选中复制" Style="{StaticResource Subtitle}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <TextBox x:Name="RecognizedText" MinHeight="70" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" Padding="12" Background="#FAFCFB"/>
    </DockPanel></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0" Visibility="{Binding ShowTranslation, Converter={StaticResource BoolVisibility}}"><DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button x:Name="CopyTranslationButton" Content="复制译文" Command="{Binding CopyTranslationCommand}" DockPanel.Dock="Right" Margin="0"/><StackPanel><TextBlock Text="翻译结果" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding TranslationNotice}" Style="{StaticResource Subtitle}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <TextBox x:Name="TranslatedText" MinHeight="70" Text="{Binding Translated, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" Padding="12" Background="#FAFCFB"/>
    </DockPanel></Border>
   </Grid>
  </Grid>
  </DockPanel>
  </Grid>
  </ScrollViewer>
 </DockPanel>
</Window>
