<Window x:Class="Snip.App.Views.PinHotkeySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="自用截图 · 贴图快捷键" Width="650" Height="570" MinWidth="560" MinHeight="500" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="贴图快捷键" Style="{StaticResource PageTitle}"/><TextBlock Text="全局生效，可分别设置或留空。截图快捷键保持原有设置。" Style="{StaticResource Subtitle}" Margin="0,7,0,0"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="恢复上一张关闭贴图" VerticalAlignment="Center"/><TextBox x:Name="RestoreGestureBox" Grid.Column="1" Tag="Restore" Text="{Binding RestoreText,Mode=OneWay}" IsReadOnly="True" PreviewKeyDown="CaptureKey" FontSize="17" Margin="0,0,0,10"/>
   <TextBlock Grid.Row="1" Text="定位上一张贴图" VerticalAlignment="Center"/><TextBox x:Name="PreviousGestureBox" Grid.Row="1" Grid.Column="1" Tag="Previous" Text="{Binding PreviousText,Mode=OneWay}" IsReadOnly="True" PreviewKeyDown="CaptureKey" FontSize="17" Margin="0,0,0,10"/>
   <TextBlock Grid.Row="2" Text="定位下一张贴图" VerticalAlignment="Center"/><TextBox x:Name="NextGestureBox" Grid.Row="2" Grid.Column="1" Tag="Next" Text="{Binding NextText,Mode=OneWay}" IsReadOnly="True" PreviewKeyDown="CaptureKey" FontSize="17"/>
  </Grid></Border>
  <StackPanel Grid.Row="2" Margin="0,16,0,12"><TextBlock Text="{Binding Status}" Style="{StaticResource Subtitle}"/><TextBlock Text="示例：Ctrl+Alt+F6 / F7 / F8。未设置的操作可继续从贴图管理使用。" Style="{StaticResource Subtitle}" FontSize="12" Margin="0,10,0,0"/></StackPanel>
  <DockPanel Grid.Row="3"><Button Content="全部清空" Command="{Binding ResetCommand}" Style="{StaticResource QuietButton}" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关闭" Click="CloseClick"/><Button x:Name="SavePinShortcutsButton" Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel>
 </Grid>
</Window>
