<Window x:Class="Snip.App.Views.TranslationReadingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Snip.App.Views"
 Title="自用截图 · 译文阅读" Width="1100" Height="820" MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="译文阅读" Style="{StaticResource PageTitle}"/><WrapPanel>
   <TextBlock Text="{Binding ResultDirection}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <Button x:Name="ReadingSpeakButton" Command="{Binding SpeakTranslationCommand}" Visibility="{Binding ShowSpeechButton,Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><local:UiIcon Kind="speaker" Width="18" Height="18"/><TextBlock Text="{Binding SpeechActionText}" Margin="6,0,0,0"/></StackPanel></Button>
   <Button x:Name="ReadingCopyButton" Content="复制译文" Command="{Binding CopyTranslationCommand}"/>
   <TextBlock Text="字号" VerticalAlignment="Center" Margin="14,0,6,0"/><ComboBox x:Name="ReadingFontSizeBox" Width="80" SelectedValuePath="Tag" SelectedValue="18"><ComboBoxItem Content="16" Tag="16"/><ComboBoxItem Content="18" Tag="18"/><ComboBoxItem Content="20" Tag="20"/><ComboBoxItem Content="24" Tag="24"/></ComboBox>
  </WrapPanel></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"><TabControl x:Name="ReadingTabs" Style="{StaticResource TranslationTabs}">
   <TabItem Header="完整译文" Style="{StaticResource TranslationTab}"><TextBox x:Name="ReadingTranslation" Text="{Binding Translated,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="16" FontSize="{Binding SelectedValue,ElementName=ReadingFontSizeBox}"/></TabItem>
   <TabItem Header="读音与词汇" Style="{StaticResource TranslationTab}" IsEnabled="{Binding HasLanguageNotes}"><TextBox x:Name="ReadingNotes" Text="{Binding LanguageNotes,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="16" FontSize="16" Background="#F0F7F4"/></TabItem>
  </TabControl></Border>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="CloseReadingButton" DockPanel.Dock="Right" Style="{StaticResource FooterCloseButton}" Click="CloseClick"/><StackPanel VerticalAlignment="Center" Margin="3,0,12,0"><TextBlock Text="{Binding CopyStatus}" Style="{StaticResource TranslationStatus}"/><TextBlock Text="{Binding SpeechStatus}" Style="{StaticResource TranslationStatus}"/></StackPanel></DockPanel>
 </Grid>
</Window>
