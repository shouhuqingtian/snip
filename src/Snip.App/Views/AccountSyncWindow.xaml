<Window x:Class="Snip.App.Views.AccountSyncWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="自用截图 · 账号与同步" Width="760" Height="830" MinWidth="540" MinHeight="480" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <TextBlock Text="账号与同步" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="工作和家里的电脑，登录同一个账号即可同步服务配置。" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,8,0,16"/>
   <Border x:Name="AuthFeedback" Padding="16" CornerRadius="12" BorderThickness="1">
    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EDF4FA"/><Setter Property="BorderBrush" Value="#C9DDED"/>
     <Style.Triggers><DataTrigger Binding="{Binding FeedbackSuccess}" Value="True"><Setter Property="Background" Value="#E7F5EE"/><Setter Property="BorderBrush" Value="#9ACFB6"/></DataTrigger><DataTrigger Binding="{Binding FeedbackError}" Value="True"><Setter Property="Background" Value="#FFF0EF"/><Setter Property="BorderBrush" Value="#E7A5A0"/></DataTrigger><DataTrigger Binding="{Binding FeedbackWarning}" Value="True"><Setter Property="Background" Value="#FFF6E7"/><Setter Property="BorderBrush" Value="#E2C28F"/></DataTrigger></Style.Triggers>
    </Style></Border.Style>
    <DockPanel><TextBlock Text="{Binding FeedbackSymbol}" FontSize="26" FontWeight="SemiBold" Margin="0,0,14,0" DockPanel.Dock="Left"/><StackPanel><TextBlock x:Name="AuthFeedbackTitle" Text="{Binding FeedbackTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="AuthFeedbackDetail" Text="{Binding FeedbackDetail}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DockPanel>
   </Border>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
   <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>
   <Border BorderThickness="1" CornerRadius="10" Padding="12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SyncProblem}" Value="True"><Setter Property="Background" Value="#FFF0EF"/><Setter Property="BorderBrush" Value="#E7A5A0"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding SyncHeading}" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock x:Name="SyncStatus" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
   <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0"><Button Style="{StaticResource FooterCloseButton}" Click="CloseClick"/><Button x:Name="LogoutSyncButton" Content="退出此设备" Command="{Binding LogoutCommand}" Visibility="{Binding SignedIn,Converter={StaticResource BoolVisibility}}"/><Button x:Name="SyncNowButton" Content="立即同步" Command="{Binding SyncCommand}" Visibility="{Binding SignedIn,Converter={StaticResource BoolVisibility}}"/><Button x:Name="SyncLoginButton" Content="{Binding LoginText}" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding ShowCredentials,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
  </StackPanel>
  <ScrollViewer x:Name="AuthViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
    <TextBlock Text="{Binding AccountSummary}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding SignedIn,Converter={StaticResource BoolVisibility}}"/>
    <Grid IsEnabled="{Binding CanEdit}" Visibility="{Binding ShowCredentials,Converter={StaticResource BoolVisibility}}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10"><RadioButton x:Name="SyncLoginMode" Content="登录" GroupName="AccountMode" IsChecked="{Binding LoggingIn}" Padding="16,8"/><RadioButton x:Name="SyncRegisterBox" Content="注册新账号" GroupName="AccountMode" IsChecked="{Binding Registering}" Padding="16,8"/></StackPanel>
     <TextBlock Grid.Row="1" Text="同步服务器" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="SyncServerBox" Text="{Binding Server,UpdateSourceTrigger=PropertyChanged}" LostFocus="ServerLostFocus" Margin="0,4,0,8" ToolTip="可手动更改默认地址；粘贴 /health 健康检查地址会自动调整。"/>
     <TextBlock Grid.Row="2" Text="账号" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="SyncUserBox" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
     <TextBlock Grid.Row="3" Text="密码" FontWeight="SemiBold" VerticalAlignment="Center"/><PasswordBox Grid.Row="3" Grid.Column="1" x:Name="SyncPasswordBox" PasswordChanged="PasswordChanged" Height="38" Padding="10,8" Margin="0,4,0,8"/>
     <TextBlock Grid.Row="4" Text="确认密码" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding Registering,Converter={StaticResource BoolVisibility}}"/><PasswordBox Grid.Row="4" Grid.Column="1" x:Name="SyncConfirmationBox" PasswordChanged="ConfirmationChanged" Height="38" Padding="10,8" Margin="0,4,0,8" Visibility="{Binding Registering,Converter={StaticResource BoolVisibility}}"/>
     <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="密码至少 12 位，也用于解密云端配置，请妥善保存。" Style="{StaticResource Subtitle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </Grid>
    <StackPanel Visibility="{Binding SignedIn,Converter={StaticResource BoolVisibility}}"><TextBlock Text="同步服务器" FontWeight="SemiBold"/><TextBox Text="{Binding Server,Mode=OneWay}" IsReadOnly="True" ToolTip="退出此设备后可更改同步服务器" Margin="0,6,0,0"/></StackPanel>
    <CheckBox x:Name="AutomaticSyncBox" Content="自动同步（约每 30 秒检查一次）" IsChecked="{Binding Automatic}" IsEnabled="{Binding CanToggleAutomatic}" Margin="0,16,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding Conflict,Converter={StaticResource BoolVisibility}}"><StackPanel>
    <TextBlock Text="需要选择同步方向" Style="{StaticResource SectionTitle}"/><TextBlock Text="两边的配置不一致，自动同步已暂停。选择你想保留的配置后继续。" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="UseCloudButton" Content="使用云端配置" Command="{Binding UseCloudCommand}"/><Button x:Name="UseLocalButton" Content="上传本机配置" Command="{Binding UseLocalCommand}"/></WrapPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="同步哪些内容" Style="{StaticResource SectionTitle}"/><TextBlock Text="翻译、OCR 和 AI 语音的服务配置、密钥及默认方式。配置加密后上传；截图、识别文字和本地模型保留在本机。" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
