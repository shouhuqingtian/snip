<Window x:Class="Snip.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Snip.App.Views" Title="自用截图" Width="600" Height="640" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,24">
   <Border Width="48" Height="48" Background="{StaticResource AccentBrush}" CornerRadius="14" DockPanel.Dock="Left" Margin="0,0,14,0"><local:UiIcon Foreground="White" Width="28" Height="28"/></Border>
   <StackPanel><TextBlock Text="自用截图" Style="{StaticResource PageTitle}"/><TextBlock Text="把灵感与信息，留在画面里。" Style="{StaticResource Subtitle}" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24" Margin="0,0,0,18">
   <StackPanel><TextBlock Text="随时截取，轻松表达" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="选择屏幕区域，直接标注、复制或保存。" Style="{StaticResource Subtitle}" Margin="0,8,0,18"/>
    <Button x:Name="StartCaptureButton" Style="{StaticResource PrimaryButton}" Command="{Binding CaptureCommand}" Height="48" Margin="0" FontSize="15"><StackPanel Orientation="Horizontal"><local:UiIcon Width="21" Height="21" Margin="0,0,10,0"/><TextBlock Text="开始截图" VerticalAlignment="Center"/></StackPanel></Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"><TextBlock Text="全局快捷键" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/><Border Background="{StaticResource WindowBrush}" CornerRadius="6" Padding="10,5"><TextBlock Text="Ctrl + Alt + A" FontFamily="Segoe UI" FontWeight="SemiBold"/></Border></StackPanel>
   </StackPanel>
  </Border>
  <UniformGrid Grid.Row="2" Columns="2" Rows="2" Margin="-5,0,-5,12">
   <Border Style="{StaticResource Card}" Padding="16,12" Margin="5"><DockPanel><local:UiIcon Kind="pen" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/><StackPanel><TextBlock Text="画面标注" FontWeight="SemiBold"/><TextBlock Text="形状、箭头、文字与马赛克" FontSize="11" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
   <Border Style="{StaticResource Card}" Padding="16,12" Margin="5"><DockPanel><local:UiIcon Kind="ocr" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/><StackPanel><TextBlock Text="文字识别" FontWeight="SemiBold"/><TextBlock Text="提取文字，离线中英互译" FontSize="11" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
   <Border Style="{StaticResource Card}" Padding="16,12" Margin="5"><DockPanel><local:UiIcon Kind="scroll" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/><StackPanel><TextBlock Text="网页长截图" FontWeight="SemiBold"/><TextBlock Text="Chrome / Edge 自动滚动" FontSize="11" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
   <Border Style="{StaticResource Card}" Padding="16,12" Margin="5"><DockPanel><local:UiIcon Kind="pin" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/><StackPanel><TextBlock Text="桌面贴图" FontWeight="SemiBold"/><TextBlock Text="随手置顶，方便对照参考" FontSize="11" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
  </UniformGrid>
  <StackPanel Grid.Row="3"><DockPanel><Button Content="导出诊断包…" Style="{StaticResource QuietButton}" Command="{Binding ExportDiagnosticsCommand}" DockPanel.Dock="Right" ToolTip="反馈问题时附上诊断包，不含截图和识别文本" Margin="8,0,0,0"/><TextBlock Text="{Binding Status}" Style="{StaticResource Subtitle}" FontSize="12" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/></StackPanel>
 </Grid>
</Window>
