<Window x:Class="Snip.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="自用截图" Width="540" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <Grid Margin="36">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="自用截图" FontSize="32" FontWeight="Bold"/><TextBlock Text="选取画面，轻松标注。" Foreground="#61758B" Margin="0,8,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24" Margin="0,24" BorderBrush="#DEE5EE" BorderThickness="1">
      <StackPanel VerticalAlignment="Center">
        <Button Content="开始截图" FontSize="19" Background="#168B73" Foreground="White" Command="{Binding CaptureCommand}" Padding="20,14"/>
        <TextBlock Text="全局快捷键  Ctrl + Alt + A" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="#61758B"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="版本 2.0.1 · 关闭窗口后继续在托盘运行" Foreground="#61758B" FontSize="12" Margin="0,12,0,0"/></StackPanel>
  </Grid>
</Window>
