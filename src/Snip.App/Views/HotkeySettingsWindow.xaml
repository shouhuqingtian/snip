<Window x:Class="Snip.App.Views.HotkeySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="自用截图 · 快捷键设置" Width="510" Height="380" MinWidth="400" MinHeight="320" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="截图快捷键" Style="{StaticResource PageTitle}"/><TextBlock Text="自定义全局快捷键，默认 Ctrl+Alt+A。" Style="{StaticResource Subtitle}" Margin="0,8,0,20"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="点击下方输入框，按下快捷键组合" Margin="0,0,0,10"/><TextBox x:Name="GestureBox" IsReadOnly="True" Text="{Binding GestureText, Mode=OneWay}" FontSize="20" Padding="12" PreviewKeyDown="CaptureKey" ToolTip="例如 Ctrl+Shift+A 或 Ctrl+Alt+F9。Esc 关闭设置。"/></StackPanel></Border>
  <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Subtitle}" Margin="0,16,0,12" TextWrapping="Wrap"/>
  <DockPanel Grid.Row="3"><Button Content="恢复默认" Command="{Binding ResetCommand}" Style="{StaticResource QuietButton}" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关闭" Click="CloseClick" Margin="0,0,8,0"/><Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel>
 </Grid>
</Window>
