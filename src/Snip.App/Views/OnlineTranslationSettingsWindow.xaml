<Window x:Class="Snip.App.Views.OnlineTranslationSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="自用截图 · 在线翻译设置" Width="720" Height="710" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="24">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16"><Button Content="关闭 Esc" Click="CloseClick" DockPanel.Dock="Right"/><TextBlock Text="在线大模型翻译" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/></DockPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource Subtitle}" FontSize="12"/>
   <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="清除当前密钥" Command="{Binding ClearKeyCommand}"/><Button Content="测试连接" Command="{Binding TestCommand}"/><Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="在线模式将识别后的文字发送给所选服务，费用由服务商收取；截图仍留在本机。测试连接会发送固定短句，也可能计费。" Style="{StaticResource Subtitle}" Margin="0,0,0,16"/>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="服务商" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="ProviderChoice" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" Margin="0,6,0,14"/>
    <TextBlock Text="API 地址" Style="{StaticResource SectionTitle}"/><TextBox x:Name="EndpointBox" Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,4"/>
    <TextBlock Text="填写服务商的 API 基础地址，也可填写完整 chat/completions 地址。通义千问地址须与密钥地域匹配。" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,0,0,14"/>
    <TextBlock Text="模型名称" Style="{StaticResource SectionTitle}"/><TextBox x:Name="ModelBox" Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
    <TextBlock Text="API Key" Style="{StaticResource SectionTitle}"/><PasswordBox x:Name="ApiKeyBox" PasswordChanged="KeyChanged" Padding="10,8" Margin="0,6,0,4"/>
    <TextBlock Text="{Binding KeyHint}" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,0,0,16"/>
    <CheckBox Content="新截图默认使用在线翻译" IsChecked="{Binding DefaultOnline}"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
