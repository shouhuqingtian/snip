<Window x:Class="Snip.App.Views.ApplicationSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Snip.Core;assembly=Snip.Core" Title="自用截图 · 通用设置" Width="660" Height="640" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="24">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="通用设置" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/></DockPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
   <TextBlock Text="{Binding Status}" Style="{StaticResource Subtitle}" FontSize="12"/>
   <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0"><Button Style="{StaticResource FooterCloseButton}" Click="CloseClick"/><Button x:Name="SaveDefaultsButton" Content="保存默认翻译设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
    <TextBlock Text="启动" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
    <CheckBox x:Name="StartupCheckBox" Content="登录 Windows 后自动启动，常驻托盘" IsChecked="{Binding StartWithWindows,Mode=TwoWay}"/>
    <TextBlock Text="开关即时保存，无需管理员权限。便携版请先放在固定文件夹；移动后需重新开启。若 Windows 的“启动应用”禁用了此项，还需在系统设置中启用。" Style="{StaticResource Subtitle}" FontSize="12" Margin="0,10,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="默认翻译方式" Style="{StaticResource SectionTitle}"/>
    <ComboBox x:Name="DefaultModeBox" SelectedValue="{Binding Mode,Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,10,0,8">
     <ComboBoxItem Content="在线大模型" Tag="{x:Static core:TranslationMode.Online}"/>
     <ComboBoxItem Content="离线模型" Tag="{x:Static core:TranslationMode.Offline}"/>
     <ComboBoxItem Content="基础词典（离线查词 / 简单短语）" Tag="{x:Static core:TranslationMode.Basic}"/>
    </ComboBox>
    <ComboBox x:Name="DefaultDirectionBox" SelectedValue="{Binding Direction,Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,10"><ComboBoxItem Content="自动（中文译英文，英文译中文）" Tag="auto"/><ComboBoxItem Content="英文 → 中文" Tag="en-zh"/><ComboBoxItem Content="中文 → 英文" Tag="zh-en"/></ComboBox>
    <TextBlock Text="基础词典内置常用词和部分短语，不联网、不加载模型，提供词义参考，不进行整句翻译。在线或离线服务不可用时保留原文，由你选择其他方式。" Style="{StaticResource Subtitle}" FontSize="12"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
