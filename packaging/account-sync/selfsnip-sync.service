[Unit]
Description=SelfSnip private encrypted configuration sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=selfsnip-sync
Group=selfsnip-sync
WorkingDirectory=/var/lib/selfsnip-sync
EnvironmentFile=/etc/selfsnip-sync.env
ExecStart=/opt/selfsnip-sync/current/Snip.Sync.Server
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/selfsnip-sync
MemoryMax=256M
CPUQuota=50%
TasksMax=64
LimitCORE=0

[Install]
WantedBy=multi-user.target
